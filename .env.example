# OVHcloud KMS (endpoint de la région de ton serveur)
OKMS_ENDPOINT=https://eu-west-par.okms.ovh.net
OKMS_SERVICE_KEY_ID=00000000-0000-0000-0000-000000000000
OKMS_CERT_PATH=/etc/monapp/okms.crt
OKMS_KEY_PATH=/etc/monapp/okms.key

# Data keys EMBALLÉES (sortie de scripts/generate-datakey.ts), jamais en clair
FIELD_KEYS=k1:<clé chiffrée>
FIELD_KEY_CURRENT=k1
BLIND_INDEX_KEY=<clé chiffrée>
