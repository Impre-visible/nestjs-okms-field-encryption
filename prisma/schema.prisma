generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Les champs listés dans src/prisma/encrypted-fields.ts sont chiffrés par
// l'extension avant d'arriver ici. Un dump ne contient que des chiffrés
// (v1.<clé>.<iv>.<ct>.<tag>). L'id sert d'AAD : il doit être une String.

model Client {
  id       String    @id @default(uuid())
  /// En clair : sert à trier et afficher les listes
  name     String
  /// Chiffré
  siret    String
  /// Index aveugle HMAC du SIRET (rempli par l'extension, d'où le ?)
  siretIdx String?   @unique
  /// Chiffré
  iban     String?
  /// Chiffré
  notes    String?
  invoices Invoice[]
}

model Invoice {
  id       String @id @default(uuid())
  amount   Int
  /// Chiffré
  label    String
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}
